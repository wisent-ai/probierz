# Local author-spec / author-manifest model boundary.
# HTTPS is required unless the router is reached over loopback HTTP.
STADO_MODEL_ROUTER_URL=https://brama.wisent.com
STADO_MODEL_ROUTER_TOKEN=replace-with-router-scoped-token
PROBIERZ_FIGURE_VISION_MODEL=
# Complete SEO evaluator: two independent pinned graders and one pinned
# adjudicator used only when their scores or blocker sets materially diverge.
PROBIERZ_MODEL_AGENT_ID=probierz
PROBIERZ_MODEL_AGENT_SECRET=
PROBIERZ_SEO_PRIMARY_MODEL=
PROBIERZ_SEO_SECONDARY_MODEL=
PROBIERZ_SEO_ADJUDICATOR_MODEL=
PROBIERZ_SEO_BASE_URL=
PROBIERZ_SEO_HOST=stado:mini

# Release/nightly/production evidence is signed with an Ed25519 PKCS#8 key.
# Local execution accepts a PEM file; Stado materializes the base64 PKCS#8
# private_key field from the manifest-declared Skarbiec reference.
PROBIERZ_RECEIPT_PRIVATE_KEY_FILE=
PROBIERZ_SEO_RECEIPT_PRIVATE_KEY=

# Remote `probierz stado author` uses the URL above. Stado materializes the
# token from the `probierz-model-router` / `token` secret reference on the worker;
# do not place provider credentials or a Stado control token here.

# Product-owned web first-use journeys. Supply credential-free HTTPS origins
# (loopback HTTP is accepted by the specs). Auth state/token values are
# operator-provisioned secrets; leave them out of source control.
ADAM_MONITOR_BASE_URL=
COMPUTE_MARKETPLACE_BASE_URL=
SKARBIEC_HUB_BASE_URL=
SKARBIEC_HUB_TENANT=
SKARBIEC_HUB_MANAGEMENT_TOKEN=
WELES_CONSOLE_BASE_URL=
WELES_CONSOLE_STORAGE_STATE=
WISENT_APP_BASE_URL=
WISENT_APP_STORAGE_STATE=
WISENT_APP_FIRST_USE_PROFILE_JSON=
WISENT_GRADIO_BASE_URL=
WISENT_GRADIO_STEERING_VIZ_INPUTS_JSON=
WISENT_TRADE_BASE_URL=
