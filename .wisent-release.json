{
  "schema_version": 1,
  "product": "probierz",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "probierz-rs/Cargo.toml",
    "pattern": "(?m)^\\s*version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\""
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [],
      "build": {
        "argv": [
          "bash",
          "release/stado-build.sh"
        ]
      },
      "stage": {
        "bin/probierz": "bin/probierz",
        "evidence/DIGESTS": "evidence/DIGESTS"
      }
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  }
}
