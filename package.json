{
  "name": "probierz",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Cross-platform test automation toolkit: web pages through Weles, mobile (iOS/Android), native desktop and terminal applications. Agent surface (CLI + stdio MCP) with a read-only discovery layer (surfaces/specs/run commands) and an execution layer that runs a target under chosen conditions, records video/trace/screenshots, and analyzes the result.",
  "workspaces": [
    "packages/web",
    "packages/mobile",
    "packages/desktop-native",
    "packages/tui",
    "packages/desktop-cua"
  ],
  "scripts": {
    "setup": "npm install",
    "test:web": "probierz run web",
    "test:tui": "probierz run tui",
    "test:mobile:ios": "npm --workspace packages/mobile run test:ios",
    "test:mobile:ios:byk-auth": "probierz run mobile:ios:byk-auth",
    "test:mobile:ios:byk-auth:remote": "probierz run mobile:ios:byk-auth --host \"$BYK_HOST_SELECTOR\"",
    "test:mobile:ios:byk-auth:local": "probierz run mobile:ios:byk-auth --local",
    "probe:mobile:ios:byk-auth": "probierz check mobile:ios:byk-auth",
    "seed:mobile:ios:byk-auth": "probierz run mobile:ios:byk-auth --seed",
    "test:mobile:android": "npm --workspace packages/mobile run test:android",
    "test:desktop:mac": "npm --workspace packages/desktop-native run test:mac",
    "test:desktop:win": "npm --workspace packages/desktop-native run test:win",
    "appium": "appium"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@wisent/errors": "github:wisent-ai/wisent-errors#e3014d2c900e499e171aeed8804da10bc7d93bf8"
  }
}
